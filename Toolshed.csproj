<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>Toolshed</AssemblyName>
    <Version>0.3.0</Version>
    <RootNamespace>Toolshed</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">C:\Steam\steamapps\common\Railroader</GameDir>
    <UnityManagedDir Condition="'$(UnityManagedDir)' == ''">$(GameDir)\Railroader_Data\Managed</UnityManagedDir>
    <UnityModManagerDir Condition="'$(UnityModManagerDir)' == ''">$(UnityManagedDir)\UnityModManager</UnityModManagerDir>
    <ModDeployDir Condition="'$(ModDeployDir)' == ''">$(GameDir)\Mods\Toolshed-v$(Version)</ModDeployDir>
    <EnableModDeploy Condition="'$(EnableModDeploy)' == ''">false</EnableModDeploy>
  </PropertyGroup>

  <PropertyGroup>
    <UnityModManagerAssemblyPath Condition="'$(UnityModManagerAssemblyPath)' == '' and Exists('$(UnityModManagerDir)\UnityModManagerNet.dll')">$(UnityModManagerDir)\UnityModManagerNet.dll</UnityModManagerAssemblyPath>
    <UnityModManagerAssemblyPath Condition="'$(UnityModManagerAssemblyPath)' == '' and Exists('$(UnityModManagerDir)\UnityModManager.dll')">$(UnityModManagerDir)\UnityModManager.dll</UnityModManagerAssemblyPath>
    <UnityModManagerReferenceName Condition="'$(UnityModManagerReferenceName)' == '' and Exists('$(UnityModManagerDir)\UnityModManagerNet.dll')">UnityModManagerNet</UnityModManagerReferenceName>
    <UnityModManagerReferenceName Condition="'$(UnityModManagerReferenceName)' == '' and Exists('$(UnityModManagerDir)\UnityModManager.dll')">UnityModManager</UnityModManagerReferenceName>
    <HarmonyAssemblyPath Condition="'$(HarmonyAssemblyPath)' == '' and Exists('$(UnityManagedDir)\0Harmony.dll')">$(UnityManagedDir)\0Harmony.dll</HarmonyAssemblyPath>
    <HarmonyAssemblyPath Condition="'$(HarmonyAssemblyPath)' == '' and Exists('$(UnityModManagerDir)\0Harmony.dll')">$(UnityModManagerDir)\0Harmony.dll</HarmonyAssemblyPath>
    <FuseAssemblyPath Condition="'$(FuseAssemblyPath)' == '' and Exists('$(GameDir)\Mods\FUSE\FUSE.dll')">$(GameDir)\Mods\FUSE\FUSE.dll</FuseAssemblyPath>
    <FuseAssemblyPath Condition="'$(FuseAssemblyPath)' == '' and Exists('..\FUSE\FUSE\bin\Release\net48\FUSE.dll')">..\FUSE\FUSE\bin\Release\net48\FUSE.dll</FuseAssemblyPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="bin\**\*.cs" />
    <Compile Remove="obj\**\*.cs" />
    <Compile Remove="RailLoaderSelectiveInterchanges\**\*.cs" />
    <Compile Remove="RailLoaderToolshed\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(UnityModManagerReferenceName)" Condition="Exists('$(UnityModManagerAssemblyPath)')">
      <HintPath>$(UnityModManagerAssemblyPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp" Condition="Exists('$(UnityManagedDir)\Assembly-CSharp.dll')">
      <HintPath>$(UnityManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Definition" Condition="Exists('$(UnityManagedDir)\Definition.dll')">
      <HintPath>$(UnityManagedDir)\Definition.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony" Condition="Exists('$(HarmonyAssemblyPath)')">
      <HintPath>$(HarmonyAssemblyPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="KeyValue.Runtime" Condition="Exists('$(UnityManagedDir)\KeyValue.Runtime.dll')">
      <HintPath>$(UnityManagedDir)\KeyValue.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="KinematicCharacterController" Condition="Exists('$(UnityManagedDir)\KinematicCharacterController.dll')">
      <HintPath>$(UnityManagedDir)\KinematicCharacterController.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FUSE" Condition="Exists('$(FuseAssemblyPath)')">
      <HintPath>$(FuseAssemblyPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AssetPack.Common" Condition="Exists('$(UnityManagedDir)\AssetPack.Common.dll')">
      <HintPath>$(UnityManagedDir)\AssetPack.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json" Condition="Exists('$(UnityManagedDir)\Newtonsoft.Json.dll')">
      <HintPath>$(UnityManagedDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="JsonSubTypes" Condition="Exists('$(UnityManagedDir)\JsonSubTypes.dll')">
      <HintPath>$(UnityManagedDir)\JsonSubTypes.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule" Condition="Exists('$(UnityManagedDir)\UnityEngine.CoreModule.dll')">
      <HintPath>$(UnityManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule" Condition="Exists('$(UnityManagedDir)\UnityEngine.IMGUIModule.dll')">
      <HintPath>$(UnityManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule" Condition="Exists('$(UnityManagedDir)\UnityEngine.AnimationModule.dll')">
      <HintPath>$(UnityManagedDir)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule" Condition="Exists('$(UnityManagedDir)\UnityEngine.InputLegacyModule.dll')">
      <HintPath>$(UnityManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule" Condition="Exists('$(UnityManagedDir)\UnityEngine.JSONSerializeModule.dll')">
      <HintPath>$(UnityManagedDir)\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule" Condition="Exists('$(UnityManagedDir)\UnityEngine.PhysicsModule.dll')">
      <HintPath>$(UnityManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule" Condition="Exists('$(UnityManagedDir)\UnityEngine.ParticleSystemModule.dll')">
      <HintPath>$(UnityManagedDir)\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="Info.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="ServiceFacility_Audit.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="SCAssetPacks\**\*" Exclude="SCAssetPacks\ALWLoaders\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>SCAssetPacks\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </None>
    <None Include="Examples\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Examples\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </None>
  </ItemGroup>

  <Target Name="ValidateUnityReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(UnityModManagerAssemblyPath)')" Text="UnityModManagerNet.dll or UnityModManager.dll was not found. Set UnityModManagerDir or GameDir." />
    <Error Condition="!Exists('$(UnityManagedDir)\Assembly-CSharp.dll')" Text="Assembly-CSharp.dll was not found. Set GameDir to your Railroader install." />
    <Error Condition="!Exists('$(UnityManagedDir)\Definition.dll')" Text="Definition.dll was not found. Set GameDir to your Railroader install." />
    <Error Condition="!Exists('$(HarmonyAssemblyPath)')" Text="0Harmony.dll was not found. Set GameDir to your Railroader install." />
    <Error Condition="!Exists('$(UnityManagedDir)\KeyValue.Runtime.dll')" Text="KeyValue.Runtime.dll was not found. Set GameDir to your Railroader install." />
    <Error Condition="!Exists('$(UnityManagedDir)\KinematicCharacterController.dll')" Text="KinematicCharacterController.dll was not found. Set GameDir to your Railroader install." />
    <Error Condition="!Exists('$(FuseAssemblyPath)')" Text="FUSE.dll was not found. Install/build FUSE or set FuseAssemblyPath." />
    <Error Condition="!Exists('$(UnityManagedDir)\AssetPack.Common.dll')" Text="AssetPack.Common.dll was not found. Set GameDir to your Railroader install." />
    <Error Condition="!Exists('$(UnityManagedDir)\Newtonsoft.Json.dll')" Text="Newtonsoft.Json.dll was not found. Set GameDir to your Railroader install." />
    <Error Condition="!Exists('$(UnityManagedDir)\JsonSubTypes.dll')" Text="JsonSubTypes.dll was not found. Set GameDir to your Railroader install." />
    <Error Condition="!Exists('$(UnityManagedDir)\UnityEngine.CoreModule.dll')" Text="UnityEngine.CoreModule.dll was not found." />
    <Error Condition="!Exists('$(UnityManagedDir)\UnityEngine.IMGUIModule.dll')" Text="UnityEngine.IMGUIModule.dll was not found." />
    <Error Condition="!Exists('$(UnityManagedDir)\UnityEngine.AnimationModule.dll')" Text="UnityEngine.AnimationModule.dll was not found." />
    <Error Condition="!Exists('$(UnityManagedDir)\UnityEngine.InputLegacyModule.dll')" Text="UnityEngine.InputLegacyModule.dll was not found." />
    <Error Condition="!Exists('$(UnityManagedDir)\UnityEngine.JSONSerializeModule.dll')" Text="UnityEngine.JSONSerializeModule.dll was not found." />
    <Error Condition="!Exists('$(UnityManagedDir)\UnityEngine.PhysicsModule.dll')" Text="UnityEngine.PhysicsModule.dll was not found." />
    <Error Condition="!Exists('$(UnityManagedDir)\UnityEngine.ParticleSystemModule.dll')" Text="UnityEngine.ParticleSystemModule.dll was not found." />
  </Target>

  <Target Name="DeployToUnityModManagerFolder" AfterTargets="Build" Condition="'$(EnableModDeploy)' == 'true'">
    <MakeDir Directories="$(ModDeployDir)" />
    <!-- Stale mod folders from earlier versions must go, or UMM loads the mod twice.
         Settings.xml lives inside the mod folder, so carry it over before deleting. -->
    <ItemGroup>
      <ToolshedStaleModDirs Include="$(GameDir)\Mods\Toolshed" Condition="Exists('$(GameDir)\Mods\Toolshed')" />
      <ToolshedStaleModDirs Include="$([System.IO.Directory]::GetDirectories('$(GameDir)\Mods', 'Toolshed-v*'))" />
      <ToolshedStaleModDirs Remove="$(ModDeployDir)" />
    </ItemGroup>
    <Copy SourceFiles="%(ToolshedStaleModDirs.Identity)\Settings.xml" DestinationFolder="$(ModDeployDir)" Condition="'@(ToolshedStaleModDirs)' != '' and Exists('%(ToolshedStaleModDirs.Identity)\Settings.xml') and !Exists('$(ModDeployDir)\Settings.xml')" />
    <RemoveDir Directories="@(ToolshedStaleModDirs)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModDeployDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="Info.json" DestinationFolder="$(ModDeployDir)" SkipUnchangedFiles="false" />
    <ItemGroup>
      <ToolshedAssetPackFiles Include="SCAssetPacks\**\*" Exclude="SCAssetPacks\ALWLoaders\**\*" />
      <ToolshedExampleFiles Include="Examples\**\*" />
    </ItemGroup>
    <Copy SourceFiles="README.md" DestinationFolder="$(ModDeployDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="ServiceFacility_Audit.md" DestinationFolder="$(ModDeployDir)" SkipUnchangedFiles="false" />
    <ItemGroup>
      <ToolshedStaleVersionMarkers Include="$(ModDeployDir)\Toolshed-v*.txt" />
    </ItemGroup>
    <Delete Files="@(ToolshedStaleVersionMarkers)" />
    <WriteLinesToFile File="$(ModDeployDir)\Toolshed-v$(Version).txt" Lines="$(Version)" Overwrite="true" />
    <Copy SourceFiles="@(ToolshedAssetPackFiles)" DestinationFiles="@(ToolshedAssetPackFiles->'$(ModDeployDir)\SCAssetPacks\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ToolshedExampleFiles)" DestinationFiles="@(ToolshedExampleFiles->'$(ModDeployDir)\Examples\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
